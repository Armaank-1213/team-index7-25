# Copy this file to .streamlit/secrets.toml for local development
# (that file is gitignored — never commit real credentials).
#
# For the deployed app, paste the same content into
# Streamlit Cloud -> your app -> Settings -> Secrets instead of
# creating this file there.
#
# [sheets] spreadsheet_id is the long ID in your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit

[sheets]
spreadsheet_id = "your-google-sheet-id"

# [gcp_service_account] is the full contents of the JSON key file you
# downloaded when creating the service account, with the exact same
# field names. private_key must keep its literal \n line breaks.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
client_id = "your-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "your-cert-url"
